<?xml version="1.0" encoding="utf-8"?>

<!-- Identity/Publisher below are the DEVELOPMENT values. pack.ps1 rewrites Version and
     Publisher so the manifest matches the signing certificate; the Store-issued identity
     from Partner Center replaces them at submission (see docs/STORE-SUBMISSION.md). -->

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="RonEaglin.AuthorPlus"
    Publisher="CN=AuthorPlus Development"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Author+</DisplayName>
    <!-- Must match the Partner Center account's publisher display name character for character
         or certification fails. Ron's Microsoft Store account publishes as "Dean Eaglin". -->
    <PublisherDisplayName>Dean Eaglin</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="AuthorPlus" Executable="AuthorPlus.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Author+"
        Description="Write a book and keep it straight: chapters, characters, timeline and plotlines in one place, with AI help that uses your own API key."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="Author+"
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1B2A4A" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Restricted capability, standard for a desktop app. Needs written justification at
         submission; the wording is in docs/STORE-SUBMISSION.md. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- The AI features call the provider whose key the author entered. Nothing else. -->
    <Capability Name="internetClient" />
  </Capabilities>

</Package>
