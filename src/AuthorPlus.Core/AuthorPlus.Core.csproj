<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain model + on-disk book store. No UI, no AI, no Windows dependency:
       everything here is unit-testable on any OS. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AuthorPlus.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF export only (MIT). A managed library with no UI dependency, so Core stays
         platform-neutral; fonts are supplied by BookFontResolver rather than by the
         GDI/WPF flavours of the package. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AuthorPlus.Tests" />
  </ItemGroup>

</Project>
