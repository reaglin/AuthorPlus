<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain model + on-disk book store. No UI, no AI, no Windows dependency:
       everything here is unit-testable on any OS. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AuthorPlus.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF export only (MIT). A managed library with no UI dependency, so Core stays
         platform-neutral; fonts are supplied by BookFontResolver rather than by the
         GDI/WPF flavours of the package. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp 6.2.4 brings in System.Security.Cryptography.Pkcs 8.0.1, which has known advisories
         (NU1902/NU1903, fatal under TreatWarningsAsErrors). A direct reference lifts it to a fixed version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Git for the book folders (MIT). libgit2 through its own managed wrapper, so versioning
         works on a machine that has no Git installed - a Store buyer's machine. The native
         binaries come with the package and are copied into the publish folder. -->
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <!-- Windows DPAPI for the GitHub token at rest, the scheme Eaglin.AiManager uses for API
         keys (guarded by OperatingSystem.IsWindows(); Core still builds and tests anywhere). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AuthorPlus.Tests" />
  </ItemGroup>

</Project>
