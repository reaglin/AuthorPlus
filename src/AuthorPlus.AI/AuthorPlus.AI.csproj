<Project Sdk="Microsoft.NET.Sdk">

  <!-- AI provider abstraction (Claude, Gemini, OpenAI, Mistral) + encrypted settings.
       Adapted from CIATLE.AICore (..\CIATLE\CIATLE.AICore) so the three desktop apps share
       one proven shape; kept free of any AuthorPlus.Core dependency. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AuthorPlus.AI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows DPAPI for API-key encryption at rest (guarded by OperatingSystem.IsWindows()). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AuthorPlus.Tests" />
  </ItemGroup>

</Project>
