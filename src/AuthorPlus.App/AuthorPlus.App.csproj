<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for FolderBrowserDialog (WPF has no folder picker). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AuthorPlus.App</RootNamespace>
    <AssemblyName>AuthorPlus</AssemblyName>
    <ApplicationManifest Condition="Exists('app.manifest')">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms injects a global "using System.Windows.Forms" that collides with WPF
         controls (TextBox, Button…). Drop it; MainWindow aliases it as WinForms explicitly. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuthorPlus.Core\AuthorPlus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared AI layer (repo ..\AiManager). Packages come from the local feed C:\nuget-local;
         run ..\AiManager\build\pack.ps1 once on a fresh machine. The DLLs are copied into the
         publish folder, so an MSIX/Store build carries them and needs no feed at install time. -->
    <PackageReference Include="Eaglin.AiManager" Version="1.2.0" />
    <PackageReference Include="Eaglin.AiManager.Wpf" Version="1.2.0" />
  </ItemGroup>

</Project>
