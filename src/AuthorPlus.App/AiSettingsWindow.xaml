<Window x:Class="AuthorPlus.App.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Settings" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock Text="One provider handles every AI feature. Keys are encrypted with Windows DPAPI for this user account only."
                   TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,12"/>

        <TextBlock Text="Provider" FontWeight="SemiBold"/>
        <ComboBox x:Name="CmbProvider" Margin="0,2,0,10" SelectionChanged="CmbProvider_SelectionChanged"/>

        <TextBlock Text="Model" FontWeight="SemiBold"/>
        <ComboBox x:Name="CmbModel" IsEditable="True" Margin="0,2,0,10"/>

        <TextBlock Text="API key" FontWeight="SemiBold"/>
        <DockPanel Margin="0,2,0,4">
            <Button x:Name="BtnShow" DockPanel.Dock="Right" Content="Show" Width="60" Margin="6,0,0,0" Click="BtnShow_Click"/>
            <PasswordBox x:Name="PwdKey" Padding="4" PasswordChanged="PwdKey_PasswordChanged"/>
        </DockPanel>
        <TextBox x:Name="TxtKeyVisible" Padding="4" Visibility="Collapsed" Margin="0,0,0,4" TextChanged="TxtKeyVisible_TextChanged"/>
        <TextBlock x:Name="TxtKeyHint" Foreground="#777" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <CheckBox x:Name="ChkPreseMaker" Content="Use API keys saved in PreseMaker when mine is blank" Margin="0,4,0,2" Checked="ChkPreseMaker_Changed" Unchecked="ChkPreseMaker_Changed"/>
        <TextBlock x:Name="TxtPreseMaker" Foreground="#777" TextWrapping="Wrap" Margin="22,0,0,12"/>

        <DockPanel>
            <Button x:Name="BtnTest" DockPanel.Dock="Left" Content="Test connection" Width="130" Click="BtnTest_Click"/>
            <TextBlock x:Name="TxtTest" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="90" IsDefault="True" Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button Content="Close" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
