<Window x:Class="AuthorPlus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AuthorPlus.App"
        Title="AuthorPlus" Height="800" Width="1280" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

    <Window.CommandBindings>
        <CommandBinding Command="New"  Executed="NewBook_Executed"/>
        <CommandBinding Command="Open" Executed="OpenBook_Executed"/>
        <CommandBinding Command="Save" Executed="Save_Executed" CanExecute="HasBook_CanExecute"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="F11" Command="{x:Static local:MainWindow.FocusCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static local:MainWindow.FindCommand}"/>
        <KeyBinding Key="K" Modifiers="Ctrl" Command="{x:Static local:MainWindow.ConsistencyCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- ── Menu ─────────────────────────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top" x:Name="MainMenu">
            <MenuItem Header="_File">
                <MenuItem Header="_New Book…" Command="New" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open Book…" Command="Open" InputGestureText="Ctrl+O"/>
                <MenuItem x:Name="MnuRecent" Header="Open _Recent"/>
                <Separator/>
                <MenuItem Header="_Save" Command="Save" InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Export">
                    <MenuItem Header="_Word document (.docx)…" Click="ExportDocx_Click"/>
                    <MenuItem Header="_Markdown (.md)…" Click="ExportMarkdown_Click"/>
                </MenuItem>
                <MenuItem Header="Open Book _Folder" Click="OpenFolder_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Book" x:Name="MnuBook">
                <MenuItem Header="Add _Section" Click="AddSection_Click"/>
                <MenuItem Header="Add _Chapter" Click="AddChapter_Click"/>
                <MenuItem Header="Add _Item">
                    <MenuItem Header="_Notes" Click="AddNotesItem_Click"/>
                    <MenuItem Header="_Outline" Click="AddOutlineItem_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Import Chapters from _Folder…" Click="ImportFolder_Click"/>
                <MenuItem Header="Insert Chapter from Fi_le…" Click="InsertChapterFile_Click"
                          ToolTip="Add one chapter written elsewhere (DOCX, TXT or Markdown) after the selected chapter, or at the end of the selected section."/>
                <Separator/>
                <MenuItem Header="Add Ch_aracter" Click="AddCharacter_Click"/>
                <MenuItem Header="Add _Timeline Event" Click="AddEvent_Click"/>
                <MenuItem Header="Add _Plotline" Click="AddPlotline_Click"/>
                <Separator/>
                <MenuItem Header="Move _Up" Click="MoveUp_Click" InputGestureText="Alt+Up"/>
                <MenuItem Header="Move _Down" Click="MoveDown_Click" InputGestureText="Alt+Down"/>
                <MenuItem Header="_Delete…" Click="DeleteItem_Click" InputGestureText="Del"/>
                <Separator/>
                <MenuItem Header="Book _Properties" Click="BookProperties_Click"/>
                <Separator/>
                <MenuItem Header="Check _Consistency…" Click="Consistency_Click" InputGestureText="Ctrl+K"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Find and Replace" Click="Find_Click" InputGestureText="Ctrl+F"/>
                <Separator/>
                <MenuItem Header="_Distraction-free Writing" Click="Focus_Click" InputGestureText="F11" x:Name="MnuFocus"/>
                <Separator/>
                <MenuItem Header="_Preview AI Prompts Before Sending" IsCheckable="True" x:Name="MnuPreview" Click="Preview_Click"
                          ToolTip="Show the exact text, token estimate and cost of every AI request before it goes out."/>
            </MenuItem>
            <MenuItem Header="_AI" x:Name="MnuAi">
                <MenuItem Header="_Summarize This Chapter" Click="AiSummarize_Click"/>
                <MenuItem Header="_Analyze This Chapter…" Click="AiAnalyze_Click"/>
                <MenuItem Header="_Chapter Characters" Click="AiCharactersInChapter_Click" ToolTip="Who appears in the chapter (name scan + AI), as a Chapter Characters item"/>
                <MenuItem Header="Style _Report…" Click="Style_Click" ToolTip="Local prose statistics for the chapter, with an optional AI read"/>
                <Separator/>
                <MenuItem Header="Continuity Chec_k (AI)…" Click="AiContinuity_Click" ToolTip="Contradictions across the selected section (or the whole book), checked against the characters and timeline"/>
                <MenuItem Header="Plot Anal_ysis (AI)…" Click="AiPlot_Click" ToolTip="Acts, tension by chapter, slow stretches and suggested convergences, from the chapter summaries"/>
                <Separator/>
                <MenuItem Header="_Outline This Section" Click="AiSectionOutline_Click"/>
                <MenuItem Header="Summarize This S_ection" Click="AiSectionSummary_Click"/>
                <Separator/>
                <MenuItem Header="Suggest Character _Profile" Click="AiCharacter_Click"/>
                <Separator/>
                <MenuItem Header="AI _Settings…" Click="AiSettings_Click"/>
                <MenuItem Header="_Prompt Library…" Click="AiPrompts_Click"/>
                <MenuItem Header="AI _Usage…" Click="AiUsage_Click"/>
                <MenuItem Header="Open AI _Log Folder" Click="OpenLog_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About AuthorPlus" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ── Status bar ───────────────────────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom" x:Name="StatusBar">
            <StatusBarItem><TextBlock x:Name="TxtStatus" Text="No book open — File › New Book or Open Book."/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtSaved" Text="" Foreground="#555"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtWords" Text=""/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtAi" Text="" Foreground="#555"/></StatusBarItem>
        </StatusBar>

        <!-- ── Body: tree | editor ──────────────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" x:Name="TreeColumn"/>
                <ColumnDefinition Width="6" x:Name="SplitterColumn"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="#FAFAFA" x:Name="TreePane">
                <TextBlock x:Name="TxtBookTitle" DockPanel.Dock="Top" Text="AuthorPlus"
                           FontSize="16" FontWeight="SemiBold" Margin="10,10,10,6" TextTrimming="CharacterEllipsis"/>
                <TreeView x:Name="Tree" BorderThickness="0,1,0,0" BorderBrush="#DDD"
                          SelectedItemChanged="Tree_SelectedItemChanged" Padding="4"
                          PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                          AllowDrop="True" PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="Tree_PreviewMouseMove" DragOver="Tree_DragOver" Drop="Tree_Drop"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#EEE" x:Name="Splitter"/>

            <Grid Grid.Column="2" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtKind" DockPanel.Dock="Left" Text="" Foreground="#777"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtName" FontSize="18" FontWeight="SemiBold" BorderThickness="0,0,0,1"
                             Background="Transparent" TextChanged="TxtName_TextChanged" IsEnabled="False"/>
                </DockPanel>

                <ContentControl x:Name="Editor" Grid.Row="1">
                    <TextBlock Text="Open a book, then pick a section, chapter, item, character, event or plotline in the tree."
                               Foreground="#888" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </ContentControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
